ansible all -i /opt/aws_inventory/aws_ec2.yml -u ec2-user --private-key ~/.ssh/mykey.pem -m ping


ansible -i /opt/aws_inventory/aws_ec2.yml all -m ping all 

ansible all -i /opt/aws_inventory/aws_ec2.yml -u ec2-user --private-key ~/.ssh/b16ansible.pem -m ping

